FROM debian:trixie AS grub_base

# Package installation
RUN sed -i "s/main/main non-free/g" /etc/apt/sources.list.d/debian.sources

RUN apt update -y && \
    apt install -y \
    attr \
    autoconf \
    autoconf-archive \
    automake \
    autopoint \
    bison \
    btrfs-progs \
    ccache \
    clang \
    cpio \
    cryptsetup \
    curl \
    dosfstools \
    e2fsprogs \
    erofs-utils \
    exfat-fuse \
    exfatprogs \
    f2fs-tools \
    file \
    flex \
    fonts-dejavu-core \
    g++ \
    gawk \
    gcc-aarch64-linux-gnu \
    gcc-arm-linux-gnueabihf \
    gcc-mips-linux-gnu \
    gcc-mipsel-linux-gnu \
    gcc-powerpc64-linux-gnu \
    gcc-powerpc64le-linux-gnu \
    gcc-riscv64-linux-gnu \
    gcc-sparc64-linux-gnu \
    genromfs \
    gettext \
    git \
    gpg \
    gzip \
    hfsprogs \
    iproute2 \
    jfsutils \
    kmod \
    libdevmapper-dev \
    libfreetype6-dev \
    libfuse3-dev \
    liblzma-dev \
    libpciaccess-dev \
    libsdl1.2-dev \
    libtasn1-6-dev \
    locales \
    lzop \
    make \
    mingw-w64 \
    mingw-w64-tools \
    mtools \
    multitee \
    nilfs-tools \
    ntfs-3g \
    ovmf \
    parted \
    patch \
    pkg-config \
    python3 \
    qemu-system \
    qemu-system-data \
    recode \
    reiserfsprogs \
    rsync \
    squashfs-tools \
    strace \
    swtpm \
    tar \
    texinfo \
    texlive \
    tpm2-tools \
    udftools \
    unifont \
    util-linux \
    util-linux-extra \
    wamerican \
    wget \
    xfsprogs \
    xorriso \
    xz-utils \
    zfs-fuse \
    zip

RUN sed -i -E -e "s/^# (en_US.UTF-8 UTF-8)/\1/" /etc/locale.gen && \
    dpkg-reconfigure --frontend=noninteractive locales && \
    update-locale LANG=en_US.UTF-8

ENV LC_ALL=en_US.UTF-8
ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US.UTF-8

# Clone GRUB, not required for CI but perhaps useful for local testing
RUN git clone --depth 1 --no-single-branch --tags https://gitlab.freedesktop.org/gnu-grub/grub.git /grub && \
    git config --global user.email "ci-images@example.com" && \
    git config --global user.name "ci-images user"

# Extra cross-compiler download & untar
ENV CROSS_C=/usr/local/lib/gcc-13.2.0-nolibc
ARG CROSSTOOL_URL=https://mirrors.kernel.org/pub/tools/crosstool/files/bin/x86_64/13.2.0
RUN mkdir -p /usr/local/lib && \
    cd /usr/local/lib && \
    for arch in ia64 loongarch64 riscv32; do \
        url="$CROSSTOOL_URL/x86_64-gcc-13.2.0-nolibc-$arch-linux.tar.gz"; \
        echo "Fetching $url"; \
        wget -nv "$url" || { echo "Failed to fetch $url" >&2; exit 1; }; \
    done && \
    for f in *.tar.gz; do tar -xzf "$f" || exit 1; done && \
    rm -f *.tar.gz

# Clone GNULIB for a faster GRUB's bootstrap
ENV GNULIB_SRCDIR=/gnulib

# A more resilient gnulib's clone: try savannah first then coreutils's mirror
RUN for repo in https://git.savannah.gnu.org/git/gnulib.git https://github.com/coreutils/gnulib.git; do \
    	rm -rf "$GNULIB_SRCDIR"; \
    	git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=30 clone "$repo" "$GNULIB_SRCDIR" && break; \
    done

# Rust toolchain for --enable-rust, see grub-core/rust/README: rustc 1.96 or
# newer and the standard library sources (rust-src) are needed, and rustfmt is
# useful.  trixie only packages an older rustc, so trixie-backports is used,
# with the archive key of the main Debian sources.  rust-all is not used: it
# does not include rust-src.
RUN signed_by="$(sed -n 's/^Signed-By: *//p' /etc/apt/sources.list.d/debian.sources | head -n 1)" && \
    test -n "$signed_by" && \
    printf 'Types: deb\nURIs: http://deb.debian.org/debian\nSuites: trixie-backports\nComponents: main\nSigned-By: %s\n' \
        "$signed_by" > /etc/apt/sources.list.d/backports.sources && \
    apt update -y && \
    apt install -y -t trixie-backports rustc rust-src rustfmt && \
    rustc --version && \
    rustfmt --version && \
    test -f "$(rustc --print sysroot)/lib/rustlib/src/rust/library/core/src/lib.rs" && \
    test -f "$(rustc --print sysroot)/lib/rustlib/src/rust/library/compiler-builtins/compiler-builtins/src/lib.rs"

# Fix QEMU_EFI size
RUN truncate -s 64M /usr/share/qemu-efi-aarch64/QEMU_EFI.fd

FROM grub_base AS grub_coverity

# Coverity build tool
COPY coverity_tool.tgz /opt/
RUN cd /opt && tar -xzf coverity_tool.tgz && \
    mv cov-analysis-linux64-* cov-analysis
ENV PATH=$PATH:/opt/cov-analysis/bin
